# Supabase: Project Settings > Database > Connection string (use the pooler URL)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CMS_SECRET=
CMS_ENV=production
# Comma-separated frontend origins allowed to call the API
CMS_CORS_ORIGINS=https://your-frontend.example.edu
# Real deployments: don't create admin123-style test accounts
CMS_SEED_TEST_USERS=0
